import "design/tokens.elyx" as tokens
import "design/components/Navbar.elyx" as navbarLibrary
import "design/components/Footer.elyx" as footerLibrary

export MemorialScreen = frame {
  left: 0px,
  top: 0px,
  width: 1200px,
  layout: {direction: .column, align-items: .center},
  fill: tokens.colors.bgCanvas,
  children: [topNav, mainContentStack, bottomFooter],

  // 1. Navigation Bar
  topNav = frame : navbarLibrary.Navbar {
    width: 100%,

    brandLink {
      left: 32px,
      top: 23px,
      width: .auto,
      height: 17px,

      brandTitle {
        font-size: 12,
        font-family: "Cabin",
        font-style: "SemiBold",
        letter-spacing: 25%
      }
    }

    navLinks {
      linkMemories {
        contents: "SHARE A MEMORY",
        font-size: 10,
        font-family: "Cabin",
        font-style: "SemiBold",
        letter-spacing: 20%
      }

      linkDetails {
        contents: "SERVICE DETAILS",
        font-size: 10,
        font-family: "Cabin",
        font-style: "SemiBold",
        letter-spacing: 20%
      }

      rsvpBtn {
        rsvpLabel {
          font-family: "Cabin",
          font-style: "Regular"
        }
      }
    }
  }

  // 2. Main Body Content (Matching app/page.tsx layout)
  mainContentStack = frame {
    left: 0px,
    top: 63px,
    width: 1200px,
    layout: {direction: .column, align-items: .center, item-gap: 48px},
    padding: [48px, 0px, 64px]
  }

  // 3. Page Footer
  bottomFooter = frame : footerLibrary.Footer {
    left: 0px,
    top: 0px,
    height: 100%,
    layout.item-gap: 32px,
    overrides: [
      insert(footerDetails, after = footerLibrary.Footer.footerHeading),
      remove(footerLibrary.Footer.footerRoles),
      remove(footerLibrary.Footer.footerDates)
    ],

    footerCopyright {
      fill[0].color: tokens.colors.brand900
    }
  }

  GroupedStack = frame {
    left: 164.5px,
    top: 0px,
    width: 435px,
    height: .auto,
    layout: {direction: .column, align-items: .center, item-gap: 10px},
    overflow: .visible,
    children: [tributeTag, personName]
  }

  tributeTag = text {
    left: 155px,
    top: 0px,
    width: 125px,
    height: 24px,
    fill: tokens.colors.brand700,
    contents: "A Tribute to Rick",
    font-size: 20,
    font-family: tokens.typography.fontSerif,
    font-style: "Italic"
  }

  personName = text {
    left: 0px,
    top: 96px,
    width: 435px,
    height: 58px,
    fill: tokens.colors.brand950,
    contents: "Richard Earl LaDow Jr.",
    font-size: 48,
    font-family: tokens.typography.fontSerif
  }

  layer1 = frame {
    left: 24px,
    top: 58px,
    width: 75%,
    height: 42px,
    overflow: .visible,
    children: pcDesc
  }

  pcDesc = text {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 42px,
    fill: tokens.colors.brand700,
    contents: "To keep this space private and meaningful for Rick’s family, please enter the family passcode from your invitation or flyer to share a memory.",
    font-size: 12,
    font-family: tokens.typography.fontSans,
    line-height: 1.75,
    align: .center
  }

  footerDetails = frame {
    layout: {direction: .column, align-items: .center, item-gap: 24px},
    overflow: .visible,
    children: layer2
  }

  layer2 = frame {
    left: 356.5px,
    top: 103px,
    width: 487px,
    height: 61px,
    overflow: .visible,
    children: [footerDates, footerRoles]
  }

  footerDates = text {
    left: 134px,
    top: 0px,
    width: 219px,
    height: 24px,
    fill: tokens.colors.brand400,
    contents: "October 5, 1957 — June 8, 2026",
    font-size: 20,
    font-family: tokens.typography.fontSerif,
    font-style: "Italic"
  }

  footerRoles = text {
    left: 0px,
    top: 48px,
    width: 487px,
    height: 13px,
    fill: tokens.colors.brand500,
    contents: "HUSBAND — FATHER — PAPA — SON — BROTHER — UNCLE — FRIEND",
    font-size: 10,
    font-family: tokens.typography.fontSans,
    letter-spacing: 25%
  }
}
