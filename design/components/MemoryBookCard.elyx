use "ricks-memorial-flyer/Document fonts/CormorantGaramond-Italic.ttf"
use "ricks-memorial-flyer/Document fonts/CormorantGaramond-Regular.ttf"

import "../tokens.elyx" as tokens

export MemoryBookCard = frame {
  left: 0px,
  top: 0px,
  width: 860px,
  layout: {direction: .column, item-gap: 28px},
  fill: tokens.colors.bgSurface,
  border: tokens.colors.borderSubtle,
  corner-radius: tokens.lengths.radius-md,
  padding: 40px,
  children: [bookHeader, passcodeBox, emptyStateBox],

  bookHeader = frame {
    width: 100%,
    layout: {direction: .column, align-items: .center, item-gap: 6px},
    children: [bookTag, bookTitle, bookDivider, bookSubtitle],

    bookTag = text {
      fill: tokens.colors.brand700,
      contents: "MEMORIES & REFLECTIONS",
      font-size: 12,
      font-family: tokens.typography.fontSans,
      letter-spacing: 15%
    }

    bookTitle = text {
      fill: tokens.colors.brand950,
      contents: "Digital Memory Book",
      font-size: 32,
      font-family: tokens.typography.fontSerif
    }

    bookDivider = frame {
      width: 48px,
      height: 2px,
      fill: tokens.colors.brand400
    }

    bookSubtitle = text {
      fill: tokens.colors.brand700,
      contents: "Share a memory, story, or message of comfort for Rick’s family.",
      font-size: 14,
      font-family: tokens.typography.fontSerif,
      font-style: "Italic"
    }
  }

  passcodeBox = frame {
    width: 540px,
    layout: {direction: .column, align-items: .center, item-gap: 12px},
    fill: tokens.colors.brand50,
    border: tokens.colors.brand200,
    corner-radius: tokens.lengths.radius-md,
    padding: 24px,
    children: [pcTitle, pcDesc, pcInputRow],

    pcTitle = text {
      fill: tokens.colors.brand950,
      contents: "Family & Friends Passcode",
      font-size: 18,
      font-family: tokens.typography.fontSerif
    }

    pcDesc = text {
      fill: tokens.colors.brand700,
      contents: "To keep this space private and meaningful for Rick’s family, please enter the family passcode from your invitation or flyer to share a memory.",
      font-size: 12,
      font-family: tokens.typography.fontSans,
      align: .center
    }

    pcInputRow = frame {
      width: 320px,
      layout: {item-gap: 8px},
      children: [inputBox, unlockBtn],

      inputBox = frame {
        width: 220px,
        layout: {align-items: .center},
        fill: tokens.colors.bgSurface,
        border: tokens.colors.brand300,
        corner-radius: tokens.lengths.radius-sm,
        padding: [8px, 12px],
        children: inputPlaceholder,

        inputPlaceholder = text {
          fill: tokens.colors.brand400,
          contents: "Enter passcode...",
          font-size: 13,
          font-family: tokens.typography.fontSans
        }
      }

      unlockBtn = frame {
        layout: {justify-content: .center, align-items: .center},
        fill: tokens.colors.brand900,
        corner-radius: tokens.lengths.radius-sm,
        padding: [8px, 16px],
        children: unlockLabel,

        unlockLabel = text {
          fill: tokens.colors.textLight,
          contents: "Unlock",
          font-size: 11,
          font-family: tokens.typography.fontSans
        }
      }
    }
  }

  emptyStateBox = frame {
    width: 100%,
    layout: {direction: .column, align-items: .center, item-gap: 8px},
    fill: tokens.colors.brand50,
    border: tokens.colors.brand200,
    corner-radius: tokens.lengths.radius-sm,
    padding: [32px, 20px],
    children: [emptyTitle, emptySubtitle],

    emptyTitle = text {
      fill: tokens.colors.brand900,
      contents: "No memories shared yet.",
      font-size: 16,
      font-family: tokens.typography.fontSerif,
      font-style: "Italic"
    }

    emptySubtitle = text {
      fill: tokens.colors.brand700,
      contents: "Be the first to share a favorite story, laugh, or message of comfort for Rick’s family.",
      font-size: 12,
      font-family: tokens.typography.fontSans
    }
  }
}
