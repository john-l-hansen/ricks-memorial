use "ricks-memorial-flyer/Document fonts/CormorantGaramond-Regular.ttf"

import "../tokens.elyx" as tokens

export LoadingScreen = frame {
  left: 0px,
  top: 0px,
  width: 600px,
  height: 400px,
  layout: {
    direction: .column,
    justify-content: .center,
    align-items: .center,
    item-gap: 24px
  },
  fill: tokens.colors.bgCanvas,
  padding: [48px, 32px],
  children: [logoMonogram, loadingBarTrack, statusText],

  logoMonogram = text {
    fill: tokens.colors.brand950,
    contents: "Richard Earl LaDow Jr.",
    font-size: 22,
    font-family: tokens.typography.fontSerif
  }

  loadingBarTrack = frame {
    width: 240px,
    height: 2px,
    fill: tokens.colors.brand200,
    corner-radius: tokens.lengths.radius-pill,
    children: loadingBarFill,

    loadingBarFill = frame {
      left: 0px,
      top: 0px,
      width: 140px,
      height: 2px,
      fill: tokens.colors.brand800,
      corner-radius: tokens.lengths.radius-pill
    }
  }

  statusText = text {
    fill: tokens.colors.brand700,
    contents: "Loading... one moment.",
    font-size: 13,
    font-family: tokens.typography.fontSans,
    font-style: "Regular",
    letter-spacing: 5%
  }
}
