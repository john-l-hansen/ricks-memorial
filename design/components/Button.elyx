import "../tokens.elyx" as tokens

export Button = frame {
  left: 0px,
  top: 0px,
  layout: {justify-content: .center, align-items: .center, item-gap: 8px},
  fill: tokens.colors.brand900,
  corner-radius: tokens.lengths.radius-sm,
  padding: [12px, 24px],
  children: label,

  label = text {
    fill: tokens.colors.textLight,
    contents: "RSVP via Email",
    font-size: 14,
    font-family: tokens.typography.fontSans
  }
}

@variant
export outlineButton = frame : Button {
  left: 200px,
  top: 0px,
  border[0].color: tokens.colors.brand700,
  fill[0].color: .transparent,

  label {
    fill[0].color: tokens.colors.brand900
  }
}

@variant
export secondaryButton = frame : Button {
  left: 400px,
  top: 0px,
  fill[0].color: tokens.colors.brand100,

  label {
    fill[0].color: tokens.colors.brand900
  }
}
