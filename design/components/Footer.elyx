use "ricks-memorial-flyer/Document fonts/CormorantGaramond-Italic.ttf"
use "ricks-memorial-flyer/Document fonts/CormorantGaramond-Regular.ttf"

import "design/tokens.elyx" as tokens

export Footer = frame {
  left: 0px,
  top: 0px,
  width: 1200px,
  layout: {
    direction: .column,
    align-items: .center,
    item-gap: tokens.lengths.spacing-xl
  },
  fill: tokens.colors.brand975,
  border: {color: tokens.colors.brand950, sides: .top},
  padding: [48px, 32px],
  children: [
    footerHeading,
    footerDates,
    footerRoles,
    footerDivider,
    footerCopyright
  ],

  footerHeading = text {
    fill: tokens.colors.brand50,
    contents: "Richard Earl LaDow Jr.",
    font-size: 26,
    font-family: tokens.typography.fontSerif
  }

  footerDates = text {
    fill: tokens.colors.brand400,
    contents: "October 5, 1957 — June 8, 2026",
    font-size: 14,
    font-family: tokens.typography.fontSerif,
    font-style: "Italic"
  }

  footerRoles = text {
    fill: tokens.colors.brand500,
    contents: "HUSBAND — FATHER — PAPA — SON — BROTHER — UNCLE — FRIEND",
    font-size: 11,
    font-family: tokens.typography.fontSans,
    letter-spacing: 15%
  }

  footerDivider = frame {
    width: 64px,
    height: 1px,
    fill: tokens.colors.brand800
  }

  footerCopyright = text {
    fill: tokens.colors.textSecondary,
    contents: "Created with deep love and cherished memories by Rick’s family.",
    font-size: 12,
    font-family: tokens.typography.fontSans
  }
}
